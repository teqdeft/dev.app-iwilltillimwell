# Optional. If this file is absent, this site reads the MAIN application's .env
# (../.env), so the settings live in one place.
#
# Only set these when this site is deployed somewhere the main application's
# .env is not readable - which is the normal case once it lives on its own
# domain.
#
# There are no database credentials here any more: this site reaches the main
# application over its API and never touches the database directly.

# The main application. Every page and every activation goes through it, and
# organization logos are served from it.
APP_URL=https://dev.iwilltilimwell.com

# REQUIRED. Must match IMWELL_SHOWCASE_SECRET in the main application's .env -
# it is what lets this site call /api/imwell/*. Without it, nothing here can
# load an organization or activate an account.
#
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
IMWELL_SHOWCASE_SECRET=

# Set to true only while debugging - it prints error details on screen.
APP_DEBUG=false
